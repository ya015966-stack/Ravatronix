# Required. Generate a long random value and set it in Render Environment.
# Never commit the real value or place it in a public repository.
RAVA_DEVICE_TOKEN=replace-with-a-long-random-secret
PORT=10000

# Chat provider: demo (default) or openai-compatible.
RAVA_CHAT_MODE=demo

# Cloudflare Workers AI uses the OpenAI-compatible chat-completions endpoint.
# Replace ACCOUNT_ID and MODEL_ID with values from an eligible Cloudflare account.
# Keep the API token private in the backend hosting service's environment settings.
# Do not enable paid billing for this project.
# RAVA_CHAT_MODE=openai-compatible
# RAVA_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
# RAVA_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# RAVA_AI_API_KEY=cloudflare-api-token

# Alternative trusted OpenAI-compatible provider:
# RAVA_AI_BASE_URL=https://provider.example/v1
# RAVA_AI_MODEL=provider-model-id
# RAVA_AI_API_KEY=private-provider-key
