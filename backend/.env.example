# Required. Generate a long random value and set it in Render Environment.
# Never commit the real value or place it in a public repository.
RAVA_DEVICE_TOKEN=replace-with-a-long-random-secret
PORT=10000

# OpenAI-compatible chat provider (backend only)
RAVA_AI_BASE_URL=https://api.openai.com/v1
RAVA_AI_API_KEY=replace-in-your-host-secret-manager
RAVA_AI_MODEL=choose-a-model-available-to-your-account

# Azure Speech (optional until a Speech resource is provisioned)
# Keep the real key only in the backend host's secret manager.
AZURE_SPEECH_KEY=replace-in-your-host-secret-manager
AZURE_SPEECH_REGION=your-speech-resource-region
AZURE_SPEECH_LOCALE=fa-IR
AZURE_SPEECH_VOICE=fa-IR-DilaraNeural
