# Required. Generate a long random value and set it in Render Environment.
# Never commit the real value or place it in a public repository.
RAVA_DEVICE_TOKEN=replace-with-a-long-random-secret
PORT=10000

# Chat provider: demo (default) or openai-compatible.
RAVA_CHAT_MODE=demo

# Only required when RAVA_CHAT_MODE=openai-compatible.
# Use a trusted provider's HTTPS OpenAI-compatible API endpoint.
RAVA_AI_BASE_URL=https://provider.example/v1
RAVA_AI_MODEL=replace-with-provider-model
RAVA_AI_API_KEY=keep-this-secret-in-server-environment
